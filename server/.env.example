# Supabase: Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres
PORT=3000

# REQUIRED for the admin dashboard. Pick your own value; there is no default any more.
ADMIN_KEY=change-me-to-something-private
# Optional but recommended: keeps customers signed in across server restarts (any long random string)
TOKEN_SECRET=

# ALTERNATIVE to DATABASE_URL (leave DATABASE_URL blank). Works with any password characters:
# PGHOST=aws-0-ap-south-1.pooler.supabase.com
# PGPORT=5432
# PGUSER=postgres.abcdefgh
# PGPASSWORD=your password here
# PGDATABASE=postgres
# For a local Postgres without SSL: PGSSL=off
